# Copy to .env for local development. Never commit .env.
DATABASE_URL=sqlite:///./fkl.db
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./local_storage
# LLM_MODE: off | live | record | replay.
# Reviewing without a key? Set replay to reproduce the committed run from samples/llm_cache.
LLM_MODE=replay
LLM_CACHE_DIR=./samples/llm_cache
# Live via Google Gemini — the provider/models the committed run actually used:
LLM_PROVIDER=openai_compat
GEMINI_API_KEY=
EXTRACT_MODEL=gemini-3.5-flash-lite
ADJUDICATE_MODEL=gemini-3.5-flash-lite
# Alternative provider — any Anthropic-compatible endpoint:
# LLM_PROVIDER=anthropic
# AGENTROUTER_API_KEY=
# AGENTROUTER_BASE_URL=https://agentrouter.org
# EXTRACT_MODEL=claude-sonnet-4-5-20250929
# ADJUDICATE_MODEL=claude-opus-4-8
FISCAL_YEAR_START_MONTH=4
PAGE_CONCURRENCY=4
BATCH_BUDGET_S=45
# Production (Vercel + Supabase)
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres
# STORAGE_BACKEND=supabase
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=pdfs
